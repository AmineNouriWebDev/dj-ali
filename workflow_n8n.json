      "parameters": {
        "jsCode": "const body = $('3. Clic Bouton Validation (POST)').first().json.body || {};\nconst rawDate = body.date || '';\nconst parts = rawDate.split('/');\nlet dateIso = rawDate;\nif (parts.length === 3) {\n  dateIso = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;\n}\n\n// 1. Sauvegarde dans staticData global de n8n\ntry {\n  const staticData = $getWorkflowStaticData('global');\n  staticData.blockedDates = staticData.blockedDates || [];\n  if (dateIso && !staticData.blockedDates.includes(dateIso)) {\n    staticData.blockedDates.push(dateIso);\n  }\n  if (rawDate && !staticData.blockedDates.includes(rawDate)) {\n    staticData.blockedDates.push(rawDate);\n  }\n} catch (e) {}\n\n// 2. Sauvegarde dans fichier /tmp si filesystem accessible\ntry {\n  const fs = require('fs');\n  const p = '/tmp/dj_ali_dates.json';\n  let fileDates = [];\n  if (fs.existsSync(p)) {\n    fileDates = JSON.parse(fs.readFileSync(p, 'utf8'));\n  }\n  if (dateIso && !fileDates.includes(dateIso)) fileDates.push(dateIso);\n  if (rawDate && !fileDates.includes(rawDate)) fileDates.push(rawDate);\n  fs.writeFileSync(p, JSON.stringify(fileDates));\n} catch (e) {}\n\nreturn [{\n  json: {\n    success: true,\n    date: rawDate,\n    dateIso\n  }\n}];"
